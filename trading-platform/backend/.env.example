# Copy to .env for local development. Never commit a real .env file.
# Every value below is a development placeholder; generate fresh secrets for
# any shared or production environment.

APP_NAME=TradeBridge
ENVIRONMENT=development

# Runtime role (restricted) and migration role (schema owner). See infra/postgres.
DATABASE_URL=postgresql+psycopg://tp_app:tp_app_dev@127.0.0.1:5432/tradeplatform
MIGRATIONS_DATABASE_URL=postgresql+psycopg://tp_owner:tp_owner_dev@127.0.0.1:5432/tradeplatform
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_BACKEND=redis

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
# python -m app.cli generate-encryption-key   ->   id:key[,id:key...]
DATA_ENCRYPTION_KEYS=k1:replace-with-output-of-generate-encryption-key
DATA_ENCRYPTION_ACTIVE_KEY=k1

FRONTEND_ORIGIN=http://localhost:3000
# false only for plain-http local development. Must be true in production.
COOKIE_SECURE=false
# Reverse proxies in front of the API whose X-Forwarded-For entry is trusted.
TRUSTED_PROXY_HOPS=1

# console prints emails (including sign-in links) to the log: development only.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

SENTRY_DSN=

# Live execution stays off unless both are set. Do not enable before the
# compliance review described in docs/architecture.md is signed off.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_COMPLIANCE_APPROVAL=
PAPER_TRADING_ENABLED=true
